{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "flagship-early-bird-reservations",
  "main": "reservation-worker.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://tcgflagship.com,https://www.tcgflagship.com,https://flagship.zeabur.app,http://127.0.0.1:5174"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QUEUE_ROOM",
        "class_name": "QueueRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-queue-room",
      "new_sqlite_classes": ["QueueRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flagship-early-bird-reservations",
      "database_id": "e2b759b7-a283-4c2c-84ce-be533917d669",
      "migrations_dir": "migrations"
    }
  ]
}

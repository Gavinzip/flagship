{
  "name": "flagship-card-show-taiwan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build && npm run assets:assert-build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets:audit": "node scripts/r2-static-assets.mjs audit",
    "assets:publish": "node scripts/r2-static-assets.mjs publish --bucket flagship-cardshow-media",
    "assets:verify": "node scripts/r2-static-assets.mjs verify --base https://flagship-cardshow-media.tree-gavin.workers.dev",
    "assets:assert-build": "node scripts/r2-static-assets.mjs assert-build",
    "assets:deploy-gateway": "npx --yes wrangler@latest deploy --config cloudflare/wrangler.media.jsonc"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "iconoir-react": "^7.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "2.0.0-alpha.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
